{
  "expo": {
    "name": "Rewear Preview",
    "slug": "rewear-preview",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08714e"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Rewear lets you photograph clothes for a listing.",
        "NSPhotoLibraryUsageDescription": "Rewear lets you choose clothing photos for a listing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08714e"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router"],
    "scheme": "rewear-preview",
    "platforms": ["ios", "android"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
